# ============================================
# OpenRouter Keys (Primary)
# Jitne chaho: _1, _2, _3 ...
# ============================================
OPENROUTER_KEY_1=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_KEY_2=sk-or-v1-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
OPENROUTER_KEY_3=sk-or-v1-zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz

# Legacy fallback (agar OPENROUTER_KEY_1 na mile to yeh use hogi)
# OPENROUTER_API_KEY=sk-or-v1-replace-with-your-real-key

# ============================================
# Gemini Keys (Fallback)
# ============================================
GEMINI_KEY_1=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_KEY_2=AIzaSyzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz

# Gemini model
GEMINI_MODEL=gemini-1.5-flash

# ============================================
# OpenRouter Config
# ============================================
AI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
CLAUDE_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_SITE_URL=https://slidewala.onrender.com

# ============================================
# Timeouts (seconds)
# Connect timeout = network issue pe fast fail
# Read timeout = LLM response ke liye (60 recommended)
# ============================================
AI_CONNECT_TIMEOUT=5
AI_KEY_TIMEOUT=60

# ============================================
# Redis (Celery + Cache)
# ============================================
REDIS_URL=redis://localhost:6379/0

# Cache TTL (seconds) — default 24 hours
AI_CACHE_TTL=86400

# ============================================
# Other
# ============================================
SECRET_KEY=replace-with-a-long-random-secret
RATE_LIMIT_COUNT=10
RATE_LIMIT_WINDOW=3600
ENABLE_WIKIMEDIA_IMAGES=true
WIKIMEDIA_USER_AGENT=SlideWala/1.0 (https://your-site.onrender.com; you@example.com)
