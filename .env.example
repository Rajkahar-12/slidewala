# ---- Flask ----
SECRET_KEY=replace-this-with-a-long-random-secret

# ---- AI provider (OpenAI-compatible Chat Completions API) ----
# Get a key from your provider (e.g. https://platform.openai.com/api-keys).
# Never put this key in HTML/JS. It is read only on the Flask server.
AI_API_KEY=sk-replace-with-your-real-key

# Base URL of the provider's /v1 API.
# OpenAI:            https://api.openai.com/v1
# OpenRouter:        https://openrouter.ai/api/v1
# Groq:              https://api.groq.com/openai/v1
# Local Ollama:      http://localhost:11434/v1
AI_BASE_URL=https://api.openai.com/v1

# Model name your provider supports. Good cheap defaults:
#   OpenAI:        gpt-4o-mini
#   OpenRouter:    openai/gpt-4o-mini
#   Groq:          llama-3.3-70b-versatile
AI_MODEL=gpt-4o-mini

# Timeout in seconds for the AI request.
AI_TIMEOUT=60
